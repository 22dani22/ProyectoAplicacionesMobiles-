# Datos de tu proyecto de Firebase
# (Consola de Firebase → Configuración del proyecto → Tus apps → Web)
#
# Copia este archivo como `.env` y rellena los valores.
# Estas claves NO son secretas: viajan dentro de la app. La seguridad la dan
# las reglas de Firestore (ver firestore.rules).

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
